<chart id="99">
  <P Name="name">MISSION SERVER - LEADER//FOLLOWER with QBot 2e and QDrone/Abort Diagnostic</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">99</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">13</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">6</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">99</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [causeBits,ageAtAbort,timeAtAbort] = fcn(descentStage,descentAbort,confirmedPad,isTracking,measuredPose,visionAge,clockTime)
%#codegen
% Latch all conditions present at the first abort sample. Diagnostic only.
% Bits: 1 pad confirmation lost, 2 tracking lost, 4 invalid pose,
%       8 below 0.45 m, 16 abort with none of these inputs observed.
persistent seenAbort savedBits savedAge savedTime
if isempty(seenAbort)
 seenAbort=false;savedBits=0;savedAge=0;savedTime=0;
end
if descentStage==0 &amp;&amp; descentAbort&lt;=0.5
 seenAbort=false;savedBits=0;savedAge=0;savedTime=0;
elseif descentAbort&gt;0.5 &amp;&amp; ~seenAbort
 bits=0;
 if confirmedPad&lt;=0.5,bits=bits+1;end
 if isTracking&lt;=0.5,bits=bits+2;end
 if ~all(isfinite(measuredPose)),bits=bits+4;end
 if isfinite(measuredPose(3)) &amp;&amp; measuredPose(3)&lt;0.45,bits=bits+8;end
 if bits==0,bits=16;end
 savedBits=bits;savedAge=visionAge;savedTime=clockTime;seenAbort=true;
end
causeBits=savedBits;ageAtAbort=savedAge;timeAtAbort=savedTime;
end
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
      </eml>
    </state>
