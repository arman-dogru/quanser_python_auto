<?xml version="1.0" encoding="utf-8"?>
<chart id="46">
  <P Name="name">MISSION SERVER - LEADER//FOLLOWER with QBot 2e and QDrone/Extract Vehicle Data - QDrone/Extract Object Data</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">46</P>
  <P Name="ssIdHighWaterMark">8</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">46</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [position, orientation, tracking] = fcn(data, index)

n = length(data)/7;

if (index&lt;=0)||(index&gt;n)
    position = zeros(1,3); orientation = zeros(1,3); tracking = 0;
else
    position = [data(index*3-2), data(index*3-1), data(index*3)];
    orientation = [data((index+n)*3 - 2), data((index+n)*3 - 1), data((index+n)*3)];
    tracking = data(index + (n*6));
end

</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
