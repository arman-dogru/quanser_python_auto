      <P Name="subviewer">56</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function stream_connection_loss  = fcn(time, state, error)

stream_connection_loss = 0;
if time &gt; 1
    if ~((state == 2)&amp;&amp;(error &gt;= 0))
        % stream connection is not established correctly
        stream_connection_loss = 1;
    end
end
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="vectorOutputs1D">1</P>
