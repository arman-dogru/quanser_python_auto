<?xml version="1.0" encoding="utf-8"?>
<chart id="124">
  <P Name="name">HORIZON FRAME CONVERSION AND ESTIMATION/Pose Switchbox/Signmoid Type</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">124</P>
  <P Name="ssIdHighWaterMark">8</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">9</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">sigmoid_type_position</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">124</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function sigmoid_type  = sigmoid_type_position(FSM_state)

% QDrone: Position Switchbox
%
% Switching between different sigmoid types based on 
% which state the FSM is in.
%
% v3.0 - 4th October, 2018
%
% INPUTS:
% -------
% FSM_state = current state of the FSM------------------------------------------------------- (#)         [1]
% 
% OUTPUTS:
% --------
% sigmoid_type = an integer whose state determines how the commands/measurements are transformed-- (#)         [1]

% Sigmoid_type = 1; This is for the IDLE, ARM, E_ABORT, E_STOP and DISABLE states of the FSM
% Sigmoid_type = 2; This is for the TAKEOFF THROTTLE state of the FSM
% Sigmoid_type = 3; This is for the FLIGHT state of the FSM
% Sigmoid_type = 4; This is for the TAKEOFF HEIGHT state of the FSM
% Sigmoid_type = 5; This is for the AUTOLAND state of the FSM

sigmoid_type = 0;

switch FSM_state
    case 1 % IDLE STATE
        sigmoid_type = 1;
    case 2 % ARM STATE
        sigmoid_type = 1;
    case 3 % TAKEOFF THROTTLE STATE
        sigmoid_type = 2;
    case 4 % TAKEOFF HEIGHT STATE
        sigmoid_type = 4;
    case 5 % FLIGHT STATE
        sigmoid_type = 3;
    case 6 % AUTOLAND STATE
        sigmoid_type = 5;
    case 7 % EMERGENCY STOP STATE
        sigmoid_type = 1;
    case 8 % EMERGENCY ABORT STATE
        sigmoid_type = 1;
    case 9 % DISABLE STATE
        sigmoid_type = 1;
end   
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="FSM_state">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="sigmoid_type">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">124</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">124</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

