<?xml version="1.0" encoding="utf-8"?>
<chart id="94">
  <P Name="name">HORIZON FRAME CONVERSION AND ESTIMATION/Pose Switchbox/MATLAB Function2</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">94</P>
  <P Name="ssIdHighWaterMark">13</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">7</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">94</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [enable, height_ref, max_height_vel, max_height_accel] = fcn(sigmoid_type, height_des, slow_lim, fast_lim, height_cur, height_vel)

% Note: Some of the cases below are identical. However, they are separated out 
% based on the states of the state machine for ease of modification in the future. 
% For example, states 4 and 5 are identical. However, if the user wants different 
% signmoid behaviour when taking off than when landing, these cases may not be the same. 

enable = 0;
height_ref = 0;
max_height_vel = 0;
max_height_accel = 0;

switch sigmoid_type
    case 1 % This is for the IDLE, ARM, E_ABORT, E_STOP and DISABLE states of the FSM
        enable = 0;
        height_ref = 0;
        max_height_vel = 0;
        max_height_accel = 0;

    case 2 % This is for the TAKEOFF THROTTLE state of the FSM
        enable = 0;
        height_ref = 0;
        max_height_vel = 0;
        max_height_accel = 0;

    case 3 % This is for the FLIGHT state of the FSM 
        enable = 1;
        height_ref = height_des;
        max_height_vel = fast_lim(1);
        max_height_accel = fast_lim(2);

    case 4 % This is for the TAKEOFF HEIGHT state of the FSM
        enable = 1;
        height_ref = height_des;
        if (height_vel &lt; 0)||(abs(height_cur - height_des) &lt;= 0.1)||(height_des &lt;= height_cur)
            max_height_vel = fast_lim(1);
            max_height_accel = fast_lim(2);
        else    
            max_height_vel = slow_lim(1);
            max_height_accel = slow_lim(2);
        end
    case 5 % This is for the AUTOLAND state of the FSM
        enable = 1;
        height_ref = 0;
        if height_vel &gt;= 0
            max_height_vel = fast_lim(1);
            max_height_accel = fast_lim(2);        
        else
            max_height_vel = slow_lim(1);
            max_height_accel = slow_lim(2);
        end
        
end</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="sigmoid_type">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
