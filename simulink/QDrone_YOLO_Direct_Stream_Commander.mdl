<?xml version="1.0" encoding="utf-8"?>
<chart id="131">
  <P Name="name">COMMANDER (ANGLE MODE)/THROTTLE SWITCHBOX /Hover Throttle Sigmoid Parameters</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">131</P>
  <P Name="ssIdHighWaterMark">12</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">10</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">131</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [enable, throttle_ref, max_throttle_vel, max_throttle_accel] = fcn(sigmoid_type, trim_throttle, takeoff_lim, land_lim, throttle_vel)

% Note: Some of the cases below are identical. However, they are separated out 
% based on the states of the state machine for ease of modification in the future. 
% For example, states 4 and 5 are identical. However, if the user wants different 
% signmoid behaviour when taking off than when landing, these cases may not be the same. 

enable = 0;
throttle_ref = 0;
max_throttle_vel = 0;
max_throttle_accel = 0;

switch sigmoid_type
    case 1 % sigmoid = 1 - Command 0 throttle
        % This is for the IDLE, ARM, E_ABORT, and DISABLE states of the FSM
        enable = 0;
        throttle_ref = 0;
        max_throttle_vel = 0;
        max_throttle_accel = 0;

    case 2 % sigmoid = 2 - Sigmoid throttle up from 0 to the trim value
        % This is for the TAKEOFF THROTTLE state of the FSM
        enable = 1;
        throttle_ref = trim_throttle;
        max_throttle_vel = takeoff_lim(1);
        max_throttle_accel = takeoff_lim(2);

    case 3 % sigmoid = 3 - Pass controller throttle straight through + trim value.
        % This is for the TAKEOFF HEIGHT and FLIGHT state of the FSM
        enable = 1;
        throttle_ref = trim_throttle;
        max_throttle_vel = takeoff_lim(1);
        max_throttle_accel = takeoff_lim(2);

    case 4 % sigmoid = 4 - Ignore controller throttle. Sigmoid it down to 0.
        % This is for the E_Landing state of the FSM
        enable = 1;
        throttle_ref = 0;
        if throttle_vel &gt; 0
            max_throttle_vel = takeoff_lim(1);
            max_throttle_accel = takeoff_lim(2);
        else
            max_throttle_vel = land_lim(1);
            max_throttle_accel = land_lim(2);
        end
        
    case 5 % sigmoid = 5 - Pass controller throttle straight through + trim value.
        % This is for the AUTOLAND state of the FSM
        enable = 1;
        throttle_ref = trim_throttle;
        max_throttle_vel = takeoff_lim(1);
        max_throttle_accel = takeoff_lim(2);

end</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="sigmoid_type">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="enable">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="trim_throttle">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="takeoff_lim">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="land_lim">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="throttle_vel">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="throttle_ref">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="11" name="max_throttle_vel">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="12" name="max_throttle_accel">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">131</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">131</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_145.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="145">
  <P Name="name">COMMANDER (ANGLE MODE)/STATE MACHINE LOGIC</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">145</P>
  <P Name="ssIdHighWaterMark">45</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">11</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">SM_logic</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">145</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [E_Abort, isArm, pt_ARM_to_TAKEOFF_THROTTLE, pt_TAKE_OFF_HEIGHT_TO_AUTOLAND, pt_FLIGHT_TO_AUTOLAND, pt_TAKEOFF_THROTTLE_TO_TAKEOFF_HEIGHT, pt_TAKE_OFF_HEIGHT_TO_FLIGHT, pt_AUTOLAND_TO_DISABLE, pt_EMERGENCY_STOP_TO_DISABLE, pt_EMERGENCY_ABORT_TO_DISABLE, Error, stop_model]...
    = SM_logic(current_state, initializing, Tracking_Issue, Communication_Issue, low_battery, trigger_1, trigger_2, E_abort, joystick_issue,...
    net_throttle_at_trim, net_throttle_close_to_zero, ctrl_throttle_close_to_zero, take_off_successful, flying_too_low, flying_too_high, close_to_ground, sensor_failed)

% Programmatic Logic Block
%
% Logic for the FSM is generated here based on a variety of signals.
% Mostly, logic to programmatically trigger the transition to either a 
% natural next state, or an Error state, is generated here.
%
% Last modified: March, 2020
%
% INPUTS:
% -------
% current_state = previous state of the FSM-------------------------------------------------- (#)         [1]
% initializing = signal representing that the system is initializing (first 5s + buffer)- - - (bool)      [1]
% comm = communication signal representing MAVLINK connection-------------------------------- (bool)      [1]
% peripheral = signal representing joystick and optitrack connection- - - - - - - - - - - - - (bool)      [2]
% low_battery = signal representing low battery---------------------------------------------- (bool)      [1]
% trigger_1 = trigger representing ARM/DISARM - - - - - - - - - - - - - - - - - - - - - - - - (bool)      [1]
% trigger_2 = trigger representing TAKEOFF/AUTOLAND------------------------------------------ (bool)      [1]
% motors_not_spinning = signal representing the motors not spinning - - - - - - - - - - - - - (bool)      [1]
% net_throttle_at_trim = trim throttle for the application drone ---------------------------- (bool)      [1]
% net_throttle_close_to_zero = net throttle is close to zero in emergency stop mode - - - - - (bool)      [1]
% ctrl_throttle_close_to_zero = ctrl throttle is close to zero in emergency stop mode - - - - (bool)      [1]
% take_off_successful = signal representing whether drone has taken-off successfully -------- (bool)      [1]
% flying_too_low = signal representing whether the drone&apos;s height is below threshold and cmd- (bool)      [1]
% flying_too_high = signal representing whether the drone&apos;s height is above threshold-------- (bool)      [1]
% close_to_ground = signal representing whether the drone is close to the ground to autoland- (bool)      [1]
% 
% OUTPUTS:
% --------
% Error = Whether an Error is issued or not                                                             (bool)    [1]
% E_Abort = fed through for ease of understanding flow (see STATE MACHINE TRANSITION BLOCK)             (bool)    [1]
% isArm = programmatic transition state                                                                 (bool)    [1]
% pt_ARM_to_TAKEOFF_THROTTLE = programmatic transition state BEGIN_STATE_TO_FINAL_STATE                 (bool)    [1]
% pt_TAKEOFF_THROTTLE_TO_TAKEOFF_HEIGHT = programmatic transition state BEGIN_STATE_TO_FINAL_STATE      (bool)    [1]
% pt_TAKE_OFF_HEIGHT_TO_AUTOLAND = programmatic transition state BEGIN_STATE_TO_FINAL_STATE             (bool)    [1]
% pt_TAKEOFF_THROTTLE_TO_TAKEOFF_HEIGHT = programmatic transition state BEGIN_STATE_TO_FINAL_STATE      (bool)    [1]
% pt_TAKE_OFF_HEIGHT_TO_FLIGHT = programmatic transition state BEGIN_STATE_TO_FINAL_STATE               (bool)    [1]
% pt_AUTOLAND_TO_DISABLE = programmatic transition state BEGIN_STATE_TO_FINAL_STATE                     (bool)    [1]
% pt_EMERGENCY_STOP_TO_DISABLE = programmatic transition state BEGIN_STATE_TO_FINAL_STATE               (bool)    [1]
% pt_EMERGENCY_ABORT_TO_DISABLE = programmatic transition state BEGIN_STATE_TO_FINAL_STATE              (bool)    [1]
% stop_model = STOP THE MODEL AFTER                                                                     (bool)    [1]

Error = 0;
E_Abort = E_abort;
isArm = false;
pt_ARM_to_TAKEOFF_THROTTLE = false;
pt_TAKEOFF_THROTTLE_TO_TAKEOFF_HEIGHT = false;
pt_TAKE_OFF_HEIGHT_TO_AUTOLAND = false;
pt_TAKE_OFF_HEIGHT_TO_FLIGHT = false;
pt_FLIGHT_TO_AUTOLAND = false;
pt_AUTOLAND_TO_DISABLE = false;
pt_EMERGENCY_STOP_TO_DISABLE = false;
pt_EMERGENCY_ABORT_TO_DISABLE = false;
stop_model = 0;

switch current_state
    %---------------------------------------------------------------------%
    case 1 % IDLE STATE
        if (Communication_Issue)||...          % Communication issue
           (joystick_issue)||...               % joystick issue
           (Tracking_Issue)||...               % optitrack issue
           (low_battery)||...                  % low batter  
           (sensor_failed)||...                % if sensor (IMU) failure is detected on drone stabilizer    
           ((trigger_1)&amp;&amp;(initializing))||...  % armed while initializing
           (trigger_2)&amp;&amp;(initializing)||...    % tried to takeoff while initializing
           (~ctrl_throttle_close_to_zero)      % if throttle isn&apos;t at zero, don&apos;t arm
           %----------------------------------------%
            Error = 1;
        elseif trigger_1 % user arms
            isArm = true;
        end
    %---------------------------------------------------------------------%    
    case 2 % ARMED STATE
        isArm = trigger_1;
        if (Communication_Issue)||...          % Communication issue
           (joystick_issue)||...               % joystick issue
           (Tracking_Issue)||...               % optitrack issue
           (low_battery)||...                  % low battery
           (sensor_failed)||...                % if sensor (IMU) failure is detected on drone stabilizer
           (~ctrl_throttle_close_to_zero)      % if throttle isn&apos;t at zero, don&apos;t arm
           %----------------------------------------%
            Error = 1;
        elseif trigger_1 &amp;&amp; trigger_2
            pt_ARM_to_TAKEOFF_THROTTLE = true;
        end        
    %---------------------------------------------------------------------%
    case 3 % TAKEOFF_THROTTLE STATE
        if (Communication_Issue)||...     % Communication issue
           (joystick_issue)||...          % joystick issue
           (Tracking_Issue)||...          % optitrack issue           
           (low_battery)||...             % low battery
           (sensor_failed)||...           % if sensor (IMU) failure is detected on drone stabilizer
           (~trigger_1)||...              % user disarms
           (~trigger_2)||...              % user commands auto-land before drone starts taking off
           (~ctrl_throttle_close_to_zero) % if throttle isn&apos;t at zero, don&apos;t arm
           %----------------------------------------%
            Error = 1;
        elseif (joystick_issue)           % joystick issue
            pt_TAKE_OFF_HEIGHT_TO_AUTOLAND = true;
        elseif net_throttle_at_trim
            pt_TAKEOFF_THROTTLE_TO_TAKEOFF_HEIGHT = true;
        end
    %---------------------------------------------------------------------%
    case 4 % TAKEOFF_HEIGHT STATE
        if (Communication_Issue)||... % Communication issue
           (joystick_issue)||...      % joystick issue
           (Tracking_Issue)||...      % optitrack issue
           (sensor_failed)||...       % if sensor (IMU) failure is detected on drone stabilizer    
           (flying_too_low)||...      % current height is below safety threshold 
           (flying_too_high)||...     % flying above safety margin (w.r.t optitrack)
           (~trigger_1)               % user disarms
            %----------------------------------------%
            Error = 1;
        elseif (~trigger_2)||low_battery 
            pt_TAKE_OFF_HEIGHT_TO_AUTOLAND = true;
        elseif take_off_successful
            pt_TAKE_OFF_HEIGHT_TO_FLIGHT = true;
        end
    %---------------------------------------------------------------------%
    case 5 % FLIGHT STATE
        if (Communication_Issue)||...   % Communication issue
           (joystick_issue)||...        % joystick issue
           (Tracking_Issue)||...        % optitrack issue
           (sensor_failed)||...         % if sensor (IMU) failure is detected on drone stabilizer
           (flying_too_low)||...        % current height is below safety threshold  
           (flying_too_high)||...       % flying above safety margin (w.r.t optitrack)
           (~trigger_1)                 % user disarms
           %----------------------------------------%
            Error = 1;
        elseif (~trigger_2)||low_battery
            pt_FLIGHT_TO_AUTOLAND = true;
        end
    %---------------------------------------------------------------------%
    case 6 % AUTOLAND STATE
        if (Communication_Issue)||...  % Communication issue
           (joystick_issue)||...       % joystick issue
           (Tracking_Issue)||...       % optitrack issue
           (sensor_failed)||...        % if sensor (IMU) failure is detected on drone stabilizer
           (flying_too_high)||...      % flying above safety margin (w.r.t optitrack)    
           (~trigger_1)||...           % user disarms
           (trigger_2)                 % user tries to takeoff while landing
           
           
           %----------------------------------------%
            Error = 1;
        elseif close_to_ground 
            pt_AUTOLAND_TO_DISABLE = true;
        end
    %---------------------------------------------------------------------%
    case 7 % EMERGENCY LAND STATE
        if net_throttle_close_to_zero 
            pt_EMERGENCY_STOP_TO_DISABLE = true;
        end
    %---------------------------------------------------------------------%
    case 8 % EMERGENCY ABORT STATE
        pt_EMERGENCY_ABORT_TO_DISABLE = true;
    %---------------------------------------------------------------------%
    case 9
        % Stop the model.
        stop_model = 1;
end

</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
