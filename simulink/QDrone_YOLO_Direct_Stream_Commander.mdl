  <Annotation SID="13571">
    <P Name="Name">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Helvetica&apos;; font-size:10px; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Courier New&apos;; font-size:10px;&quot;&gt;[   1/(4*Kf) ,  -1/(2*Kf*L_roll) ,  1/(2*Kf*L_pitch) ,  1/(4*Kt)  ;...&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Courier New&apos;; font-size:10px;&quot;&gt;    1/(4*Kf) ,  -1/(2*Kf*L_roll) , -1/(2*Kf*L_pitch) , -1/(4*Kt)  ;...&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Courier New&apos;; font-size:10px;&quot;&gt;    1/(4*Kf) ,   1/(2*Kf*L_roll) ,  1/(2*Kf*L_pitch) , -1/(4*Kt)  ;...&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Courier New&apos;; font-size:10px;&quot;&gt;    1/(4*Kf) ,   1/(2*Kf*L_roll) , -1/(2*Kf*L_pitch) ,  1/(4*Kt) ];&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%; font-family:&apos;Courier New&apos;;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Courier New&apos;; font-size:10px;&quot;&gt;See &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Courier New&apos;; font-size:10px; font-weight:600;&quot;&gt;Guides and Resources/Concepts/Drone Parametrization.pdf&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</P>
