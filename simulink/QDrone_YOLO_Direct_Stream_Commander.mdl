  <Annotation SID="13210">
    <P Name="Name">Rate limit the Throttle descent when auto-landing</P>
    <P Name="Position">[-347, 428, -129, 442]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="HorizontalAlignment">left</P>
    <P Name="VerticalAlignment">top</P>
    <P Name="ZOrder">-4</P>
  </Annotation>
  <Annotation SID="13209">
    <P Name="Name">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;Helvetica&apos;; font-size:10px; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-size:12px;&quot;&gt;This subsystem modulates throttle and control signals based on the QDrone&apos;s state&lt;/span&gt;&lt;/p&gt;
&lt;ol style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-size:12px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:12px; margin-right:0px; -qt-block-indent:0; text-indent:0px; -qt-user-state:9; line-height:100%;&quot;&gt;&lt;span style=&quot; font-size:12px;&quot;&gt;Modulate Trim throttle based on FSM&apos;s state&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-size:12px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:12px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-size:12px;&quot;&gt;Modulate the Thrust force from the height controller based on FSM&apos;s state&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-size:12px;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:12px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-size:12px;&quot;&gt;Modulate Attitude Command based on FSM&apos;s state&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:12px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:100%; font-size:12px;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-size:12px;&quot;&gt;Note that steps 2 and 3 effectively ignore the cascaded PIV controller&apos;s output unless the FSM is in the Takeoff, Flight or Auto-land states&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-size:12px;&quot;&gt;Also note that the net thrust force is the sum of the trim throttle and the height controller thrust output&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</P>
    <P Name="Position">[-1112, -130, -386, -30]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="HorizontalAlignment">left</P>
    <P Name="VerticalAlignment">top</P>
    <P Name="Interpreter">rich</P>
    <P Name="ZOrder">-5</P>
  </Annotation>
  <Annotation SID="13208">
    <P Name="Name">N/s      N/s^2</P>
    <P Name="Position">[-872, 178, -814, 192]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="HorizontalAlignment">left</P>
    <P Name="VerticalAlignment">top</P>
    <P Name="ZOrder">-6</P>
  </Annotation>
</System>

