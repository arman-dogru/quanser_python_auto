            <hasBlocks>true</hasBlocks>
            <identifier>ClassicPeriodicDiscrete0.20</identifier>
            <rateSpec type="sltp.mm.core.RateSpec">
              <period>.2</period>
            </rateSpec>
            <sti>3</sti>
          </rates>
        </tasks>
      </subgraph>
