<?xml version="1.0" encoding="utf-8"?>
<chart id="47">
  <P Name="name">PHYSICAL PLANT w// LINEAR THRUST/roll and pitch approximation 
from accelerometer</P>
  <P Name="windowPosition">[476 52 169 653]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 1680 1050 1.333333333333333]</P>
  <P Name="viewObj">47</P>
  <P Name="ssIdHighWaterMark">7</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">1</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <P Name="supportVariableSizing">0</P>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">47</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [roll_acc, pitch_acc]   = fcn(acc_body)
%#eml
n = norm(acc_body,2);
if n&gt;eps
    acc_body = acc_body/n; 
else
    acc_body = [0 0 1]&apos;;
end

roll_acc = atan2(acc_body(2),acc_body(3));
pitch_acc = atan2( -acc_body(1), acc_body(2)*sin(roll_acc)+acc_body(3)*cos(roll_acc));
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="fimathString">fimath(...
&apos;RoundMode&apos;, &apos;floor&apos;,...
&apos;OverflowMode&apos;, &apos;wrap&apos;,...
&apos;ProductMode&apos;, &apos;KeepLSB&apos;, &apos;ProductWordLength&apos;, 32,...
&apos;SumMode&apos;, &apos;KeepLSB&apos;, &apos;SumWordLength&apos;, 32,...
&apos;CastBeforeSum&apos;, true)</P>
        <P Name="fimathForFiConstructors">FimathMatlabFactoryDefault</P>
        <P Name="emlDefaultFimath">FimathUserSpecified</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="roll_acc">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="pitch_acc">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="acc_body">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[40.125 31.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">47</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
