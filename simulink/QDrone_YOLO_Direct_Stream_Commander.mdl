    <P Name="VerticalAlignment">top</P>
    <P Name="ZOrder">-4</P>
  </Annotation>
  <Annotation SID="11889">
    <P Name="Name">If communication with the model supplying reference commands has been lost for some time while the drone is armed, stop the model. This will shut off the motors as well.</P>
