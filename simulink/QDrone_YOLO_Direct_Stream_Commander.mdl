&lt;li style=&quot; font-size:14px;&quot; align=&quot;left&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:12px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-size:14px;&quot;&gt;Transform Body Frame Net Accelerations (from accelerometer) and rotations from BF to IF.&lt;/span&gt;&lt;/li&gt;
