  <Annotation SID="13566">
    <P Name="Name">&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body align=&quot;left&quot; style=&quot; font-family:&apos;Helvetica&apos;; font-size:10px; font-weight:400; font-style:normal;&quot;&gt;
&lt;p align=&quot;left&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:100%;&quot;&gt;&lt;span style=&quot; font-size:9px;&quot;&gt;Motor commands are written in the QDrone DAQ. This is the source of the sensor data as well. The Attitude and Height Estimator calculates estimates from sensor data, along with sensor calibration and conditioning.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</P>
    <P Name="Position">[814, 133, 1145, 170]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="FixedHeight">on</P>
    <P Name="FixedWidth">on</P>
    <P Name="HorizontalAlignment">left</P>
    <P Name="VerticalAlignment">top</P>
    <P Name="Interpreter">rich</P>
    <P Name="ZOrder">-6</P>
  </Annotation>
  <Annotation SID="13565">
    <P Name="Name">1. Motor Command Generation </P>
    <P Name="Position">[-109, 183, 371, 458]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="FixedHeight">on</P>
    <P Name="FixedWidth">on</P>
    <P Name="HorizontalAlignment">left</P>
